<%# Turbo Frame: the buttons get Turbo Stream responses; "Edit" breaks out (_top) to the full edit page. %>
<%= turbo_frame_tag dom_id(movie) do %>
  <div class="card p-4">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h3 class="min-w-0 break-words font-medium">
        <%= movie.title %>
        <% if movie.year %><span class="text-sm font-normal">(<%= movie.year %>)</span><% end %>
      </h3>

      <div class="flex flex-wrap items-center gap-1">
        <span class="border px-2 py-0.5 text-xs" style="border-color: <%= movie.category.color %>"><%= movie.category.name %></span>
        <span class="priority priority-<%= movie.priority %>"><%= movie.priority.humanize %></span>
      </div>
    </div>

    <% if movie.note.present? %>
      <p class="mt-1.5 text-sm whitespace-pre-line"><%= movie.note %></p>
    <% end %>

    <div class="mt-3 flex items-center gap-1">
      <%= link_to "Edit", edit_movie_path(movie), class: "btn-sm",
            data: { turbo_frame: "_top" } %>
      <%= button_to "Delete", movie_path(movie),
            method: :delete,
            form: { data: { turbo_confirm: "Delete \"#{movie.title}\"?" } },
            class: "btn-sm btn-danger" %>
    </div>

    <%= button_to next_status_action(movie), movie_path(movie),
          method: :patch,
          params: { movie: { status: movie.next_status } },
          form_class: "mt-3 flex w-full",
          class: "btn-sm w-full py-1" %>
  </div>
<% end %>
