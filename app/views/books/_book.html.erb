<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <% if book.cover.attached? %>
    <div class="cover">
      <%= image_tag book.cover, class: "w-24 h-auto" %>
    </div>
  <% else %>
    <div class="cover bg-gray-200 rounded flex items-center justify-center w-24 h-32">
      <span class="text-gray-500">No cover</span>
    </div>
  <% end %>

</div>
