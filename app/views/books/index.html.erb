<p style="color: green"><%= notice %></p>

<%= turbo_stream_from "books" %>

<% content_for :title, "Books" %>

<h1>Books</h1>

<div id="book-list">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to "Show this book", book %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
