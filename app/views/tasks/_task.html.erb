<%# Turbo Frame: the buttons get Turbo Stream responses; "Edit" breaks out (_top) to the full edit page. %>
<%= turbo_frame_tag dom_id(task) do %>
  <div class="card p-4">
    <div class="flex flex-wrap items-start justify-between gap-2">
      <h3 class="min-w-0 break-words font-medium"><%= task.title %></h3>

      <div class="flex flex-wrap items-center gap-1">
        <span class="border px-2 py-0.5 text-xs" style="border-color: <%= task.category.color %>"><%= task.category.name %></span>

        <%= link_to "Edit", edit_task_path(task), class: "btn-sm",
              data: { turbo_frame: "_top" } %>
        <%= button_to "Delete", task_path(task),
              method: :delete,
              form: { data: { turbo_confirm: "Delete \"#{task.title}\"?" } },
              class: "btn-sm btn-danger" %>
      </div>
    </div>

    <% if task.description.present? %>
      <p class="mt-1.5 text-sm whitespace-pre-line"><%= task.description %></p>
    <% end %>

    <div class="mt-4 space-y-2">
      <span class="block w-full border px-2 py-1 text-xs">
        Due <%= l(task.due_date, format: :short) %>
      </span>

      <%= button_to next_status_action(task), task_path(task),
            method: :patch,
            params: { task: { status: task.next_status } },
            form_class: "flex w-full",
            class: "btn-sm w-full py-1" %>
    </div>
  </div>
<% end %>
