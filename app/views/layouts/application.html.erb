<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Hotwire Tasks" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hotwire">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Only the Tailwind build output (app/assets/builds/application.css). %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen">
    <header class="border-b">
      <div class="mx-auto flex max-w-6xl items-center gap-8 px-4 py-4">
        <%= link_to "Hotwire Tasks", root_path, class: "text-lg font-semibold" %>
        <nav class="flex items-center gap-1 text-sm">
          <%= link_to "Tasks", tasks_path, class: "border px-3 py-2" %>
          <%= link_to "Categories", categories_path, class: "border px-3 py-2" %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8">
      <% flash.each do |type, message| %>
        <p role="<%= type == "alert" ? "alert" : "status" %>" class="mb-6 border px-4 py-3 text-sm"><%= message %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
